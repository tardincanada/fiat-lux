option.AERIAL_STRENGTH=Força da perspectiva atmosférica
option.AA_MODE=Anti-aliasing
value.AA_MODE.0=Off
value.AA_MODE.1=FXAA (light)
value.AA_MODE.2=TAA (best)
option.AA_MODE.comment=FXAA is nearly free but slightly blurry and does not stop shimmering. TAA also smooths leaves, fences and thin lines, costing 1-2 ms.
option.TAA_SHARPEN=TAA sharpness
option.TAA_SHARPEN.comment=Restores the sharpness TAA averaging removes. 0 disables.
option.TAA_BLEND=TAA history weight
option.TAA_BLEND.comment=Higher: smoother and steadier, but more ghosting in fast motion.
option.RAIN_STYLE=Rain
value.RAIN_STYLE.0=Minecraft
option.RAIN_STYLE.comment=Realistic: thin streaks lit by the sky, falling faster and fading softly at the edge. Snow: soft, slow flakes.
option.RAIN_OPACITY=Rain visibility
option.RAIN_SPEED=Rain speed
option.SNOW_FOG=Snow fog
